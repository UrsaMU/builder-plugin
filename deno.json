{
  "name": "@ursamu/builder-plugin",
  "version": "1.4.0",
  "license": "MIT",
  "description": "World-building plugin for UrsaMU — @dig, @open, @link, @describe, @examine, and a REST API.",
  "exports": {
    ".": "./mod.ts"
  },
  "publish": {
    "include": ["scripts", "mod.ts", "index.ts", "routes.ts", "batchbuild.ts", "deno.json", "README.md"],
    "exclude": ["tests"]
  },
  "tasks": {
    "test": "deno test --allow-all --unstable-kv --no-check tests/"
  },
  "lint": {
    "exclude": ["tests/"],
    "rules": {
      "exclude": ["no-import-prefix", "no-unversioned-import", "require-await"]
    }
  },
  "imports": {
    "jsr:@ursamu/ursamu": "jsr:@ursamu/ursamu@^2.3.0",
    "jsr:@std/path":      "jsr:@std/path@^0.224.0",
    "jsr:@std/assert":    "jsr:@std/assert@^0.224.0"
  }
}
